{
  "name": "train-app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:server": "cd server && node index.js",
    "dev:client": "cd client && npx vite",
    "dev": "concurrently --kill-others \"npm run dev:server\" \"npm run dev:client\"",
    "build": "cd client && npm install && npm run build",
    "start": "cd client && npx vite preview"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vercel": "^54.6.1"
  }
}
